# --- MongoDB ---
MONGODB_URI=mongodb+srv://kaushanikoner20_db_user:gctKMQfsvvrc8w0I@cluster0.yigjbqj.mongodb.net
MONGODB_DB_NAME=sahe_ids

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- ML ---
CICIDS2017_DATA_PATH=./ml/data/raw
ML_MODEL_DIR=./ml/models

# --- SAHE thresholds (bytes) — NOT hardcoded in logic, overridable here.
# Defaults below are placeholders until Phase 8 derives them experimentally.
SAHE_SMALL_THRESHOLD_BYTES=102400
SAHE_LARGE_THRESHOLD_BYTES=1048576

# --- SAHE cost function weights (must sum to a sensible scale; tune later) ---
SAHE_WEIGHT_LATENCY=0.30
SAHE_WEIGHT_CPU=0.20
SAHE_WEIGHT_MEMORY=0.10
SAHE_WEIGHT_STORAGE=0.10
SAHE_WEIGHT_SECURITY=0.30

# --- Key management (prototype only — never commit real keys) ---
# Local dev key store path; production would use a KMS.
KEY_STORE_PATH=./backend/app/crypto/.keystore_dev

# --- Firewall ---
FIREWALL_MODE=simulated   # simulated | iptables

# --- CORS (Phase 15) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
